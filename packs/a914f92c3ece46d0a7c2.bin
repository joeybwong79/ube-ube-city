.vp{position:fixed;inset:0;overflow-y:auto;-webkit-overflow-scrolling:touch;background:var(--cream,#fff9ec);color:var(--jb-ink,#3B3140);font-family:var(--f-ui,ui-rounded,system-ui,sans-serif);font-size:17px;line-height:1.4}
.vp *{box-sizing:border-box}
.vp-in{max-width:760px;margin:0 auto;padding:16px 16px 40px}
.vp h1{margin:10px 0 4px;font-size:30px;color:#713e79;text-align:center;font-family:var(--f-display,inherit)}
.vp h2{margin:18px 0 8px;font-size:20px;color:#713e79}
.vp .vp-card{background:var(--paper,#fffdf7);border:3px solid var(--line,#efb3cf);border-radius:26px;padding:16px;margin-bottom:12px;width:100%;text-align:left;font:inherit;color:inherit}
.vp button.vp-card{display:block;cursor:pointer}
.vp button.vp-card:disabled{opacity:.55;cursor:default}
.vp .vp-name{font-size:19px;font-weight:bold}
.vp .vp-hint{font-size:14px;color:var(--plum-soft,#8a5a82);margin:4px 0 0;line-height:1.4}
.vp .vp-soft{border:2px solid var(--line,#efb3cf);background:var(--paper,#fffdf7);border-radius:999px;padding:10px 18px;min-height:48px;font:inherit;font-size:17px;color:inherit;cursor:pointer}
.vp .vp-big{border:0;border-radius:999px;background:linear-gradient(#ff9ac4,var(--pink,#ee6fa4));color:#fff;font:inherit;font-size:22px;font-weight:bold;padding:14px 22px;min-height:58px;width:100%;box-shadow:0 6px 0 var(--pink-dark,#c94e86);cursor:pointer;margin:10px 0 6px}
.vp .vp-big:active{transform:translateY(4px);box-shadow:0 2px 0 var(--pink-dark,#c94e86)}
.vp .vp-pills{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}
.vp .vp-pills button{border:2px solid var(--line,#efb3cf);background:#fff;border-radius:14px;min-height:48px;padding:6px 14px;font:inherit;font-size:16px;color:inherit;cursor:pointer}
.vp .vp-pills button[aria-pressed="true"]{background:var(--pink-soft,#ffd9e8);border-color:var(--pink,#ee6fa4);font-weight:bold}
.vp .vp-row{padding:10px 0;border-top:2px solid var(--jb-line-v,#EFE4F8)}
.vp .vp-row:first-child{border-top:0}
.vp .vp-head{display:flex;gap:8px;align-items:baseline;flex-wrap:wrap}
.vp .vp-n{color:var(--plum-soft,#8a5a82);min-width:24px}
.vp .vp-title{font-weight:bold;font-size:18px}
.vp .vp-tag{border:2px solid var(--line,#efb3cf);background:var(--paper,#fffdf7);border-radius:999px;padding:1px 10px;font-size:14px;white-space:nowrap}
.vp .vp-tag.vp-some{background:var(--pink-soft,#ffd9e8);border-color:var(--pink,#ee6fa4)}
.vp .vp-moments{margin:6px 0 0 30px;padding-left:12px;border-left:3px solid var(--pink-soft,#ffd9e8)}
.vp .vp-moment{font-size:15px;margin:4px 0}
.vp .vp-odds{color:var(--plum-soft,#8a5a82)}
.vp .vp-need{font-size:12px;color:var(--plum-soft,#8a5a82);margin:1px 0 0;line-height:1.35}
.vp .vp-make{display:block;min-height:40px;padding:6px 14px;font-size:15px;margin-top:4px}
.vp details.vp-fold{margin:4px 0}
.vp details.vp-fold summary{cursor:pointer;font-size:15px;font-weight:bold;min-height:40px;display:flex;align-items:center}
.vp .vp-top{height:76px}
.vp-back{position:fixed;top:0;left:0;z-index:2;width:96px;height:96px;padding:0;border:0;background:none;cursor:pointer;-webkit-tap-highlight-color:transparent}
.vp-back canvas{display:block;width:96px;height:96px}
