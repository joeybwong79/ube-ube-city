er:$(`ube`,`Time for Rocky's dinner.`,`Rocky's dinner`),rockyDone:$(`ube`,`Rocky is all cared for today.`,`Rocky's care is all done for today`),rockyNight:$(`ube`,`Goodnight, Rocky.`,`ward at night: Rocky asleep`),rockyPlay:$(`ube`,`Rocky wants to play! Drag the feather.`,`Rocky's play: the wand`),rockyTreat:$(`ube`,`Great hunting! A tiny treat for Rocky.`,`Rocky's play: the treat after the third catch`),rockyBrush:$(`ube`,`Time to brush Rocky. Brush the way his fur grows.`,`Rocky's brushing`),rockyPurr:$(`ube`,`Purr, purr. Rocky says thank you.`,`Rocky's brushing: the heart is full`),rockyWeigh:$(`ube`,`Weigh-in day! Up on the scale, Rocky.`,`Rocky's weigh-in: onto the scale`),rockyWeighRead:$(`ube`,`How many pounds is Rocky?`,`Rocky's weigh-in: the question`),rockyWeighShow:$(`ube`,`Look. The needle points at the 10.`,`Rocky's weigh-in: a wrong pick, shown`),rockyWeighOk:$(`ube`,`About ten pounds. Just right for Rocky!`,`Rocky's weigh-in: the answer`),rockyDot:$(`ube`,`Put today’s dot on his chart.`,`Rocky's weigh-in: the chart`),rockyChartSame:$(`ube`,`Just like last week. Good news!`,`Rocky's weigh-in: the dot is on, and last week's is there`),rockyChartNext:$(`ube`,`We will weigh him again next week.`,`Rocky's weigh-in: the dot is on, the first one`),rockyLookDone:$(`ube`,`Both look healthy. Good Rocky!`,`Rocky's quick look: both places done`)},hw={pickCareHis:$(`ube`,`What will you do first? Tap a picture on his card.`,`ward: the card (a boy who stays)`),allDoneHe:$(`ube`,`All done for now! He can rest.`,`ward: nothing more ready (a boy who stays)`)},tae=e=>({arrived:$(`ube`,`${e} the rabbit came in last night. Her tummy stopped.`,`house: a new rabbit in the ward`),readyMorning:$(`ube`,`Good morning! ${e} is ready for her breakfast.`,`house: care ready in the morning`),readyWeigh:$(`ube`,`Good morning! Time for ${e}’s weigh-in.`,`house: the weigh-in is ready`),readyAfternoon:$(`ube`,`Good afternoon! ${e} is waiting for you.`,`house: care ready in the afternoon