.ube-tv-pop{position:fixed;left:0;right:0;top:calc(env(safe-area-inset-top,0px) + 108px);display:flex;justify-content:center;pointer-events:none;z-index:2147483000;font-family:'Fredoka',ui-rounded,system-ui,sans-serif}
.ube-tv-pop *{pointer-events:none}
.ube-tv-pop .pill{position:relative;display:flex;align-items:center;gap:10px;background:#fff;border:3px solid #E7DAF6;border-radius:999px;padding:7px 18px 7px 7px;box-shadow:0 10px 26px rgba(91,63,140,.22);white-space:nowrap;animation:ube-tv-pop ${nle}s both}
.ube-tv-pop .tile{width:52px;height:52px;border-radius:50%;background:#efe4fb;display:grid;place-items:center;color:#7C63A8;font-size:28px;flex:none}
.ube-tv-pop svg{width:1em;height:1em;fill:none;stroke:currentColor;stroke-width:2.25;stroke-linecap:round;stroke-linejoin:round}
.ube-tv-pop b{display:block;font:800 30px/1 'Baloo 2',ui-rounded,system-ui,sans-serif;color:#7C63A8}
.ube-tv-pop small{display:block;font:600 13px/1.2 'Fredoka',ui-rounded,system-ui,sans-serif;color:#6E6377}
.ube-tv-pop .spark{position:absolute;color:#f5c542;font-size:20px;animation:ube-tv-spark 1.25s ${Cd*.5}s both}
.ube-tv-pop .spark.p{color:#F49BB5;font-size:15px}
@keyframes ube-tv-pop{
  0%{opacity:0;transform:scale(.6)}
  ${wd(Cd*.6)}%{opacity:1;transform:scale(1.08)}
  ${wd(Cd)}%{opacity:1;transform:scale(1)}
  ${wd(2.5500000000000003)}%{opacity:1;transform:translateY(0)}
  100%{opacity:0;transform:translateY(-26px)}
