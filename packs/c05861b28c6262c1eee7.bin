:$(`ube`,`Other dogs at the park could catch it.`,`cough-home: the dog park picked`),restHotel:$(`ube`,`The dog hotel has lots of dogs. They could catch it.`,`cough-home: the dog hotel picked`),restHome:$(`ube`,`Home, away from other dogs. Just right.`,`cough-home: home picked`),walkAsk:$(`ube`,`Which one for walks?`,`cough-home: collar or harness`),walkCollar:$(`ube`,n(`A collar pulls on {his} sore neck. Try the other one.`),`cough-home: the collar picked`),walkHarness:$(`ube`,n(`A harness is kind to {his} neck. Put it on {him}.`),`cough-home: the harness picked`),harnessOn:$(`ube`,`It fits!`,`cough-home: the harness is on`),daysAsk:$(t.owner,`When will the coughing stop?`,`cough-days: the owner asks`),daysLast:$(`ube`,`This cough can last 10 to 20 days. Let's look at the calendar.`,`cough-days: how long`),daysShow:$(`ube`,`The dog hotel was on this day. Today is in gold.`,`cough-days: the calendar`),daysCount:$(`ube`,`How many days since the dog hotel?`,`cough-days: count the days`),daysAgain:$(`ube`,`Let's count again, one day at a time.`,`cough-days: a wrong count or day`),...Object.fromEntries(sS.map(e=>[`daysSince${e}`,$(`ube`,`${e} days. Dogs catch it, then cough 5 to 10 days later.`,`cough-days: the count`)])),daysStart:$(`ube`,n(`{His} cough started on this day. Count on 10 days.`),`cough-days: count on 10`),daysTwenty:$(`ube`,`Now count on 20 days.`,`cough-days: count on 20`),daysBand:$(`ube`,`It can stop any day from here to here.`,`cough-days: the days it can stop`),daysSofter:$(`ube`,`The cough gets softer in the first 5 days.`,`cough-days: softer`)},facts:{coughAfter:{fromDays:5,toDays:10,source:`[m-kc] "5-10 days after exposure"`},lasts:{fromDays:10,toDays:20,source:`[m-kc] "persists for 10-20 days"`}}}}},sS=[6,7,8,9,10],cS={boxes:[{id:`cat`,animal:`cat`,color:`#F49BB5`},{id:`dog`,animal:`dog`,color:`#6BA3CB`},{id:`rabbit`,animal:`rabbit`,color:`#8FC9A6`}],right:`rabbit`,pick:`Bunny medicine!`},vre={id:`ear-mites`,source:`CATALOGUE.md I2`,sides:[null]